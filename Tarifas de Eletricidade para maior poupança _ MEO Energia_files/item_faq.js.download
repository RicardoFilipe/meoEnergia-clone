            var blockId = $getItemValue(ctx, "BlockId");
            var siteZone = $getItemValue(ctx, "SiteZone");
            var titleLvl2 = $getItemValue(ctx, "TitleLvl2");
            var tabtitle = $getItemValue(ctx, "TabTitle");
            var description = $getItemValue(ctx, "Description");
            var orderBy = $getItemValue(ctx, "OrderBy");
            var active = $getItemValue(ctx, "Active");
            var subtitleLvl1 = $getItemValue(ctx,"SubtitleLvl1");
            var titleLvl1Mobile = $getItemValue(ctx, "TitleLvl1Mobile");
            var titleLvl2Mobile = $getItemValue(ctx, "TitleLvl2Mobile");
            var subtitleLvl1Mobile = $getItemValue(ctx, "SubtitleLvl1Mobile");
            var descriptionMobile = $getItemValue(ctx, "DescriptionMobile");

