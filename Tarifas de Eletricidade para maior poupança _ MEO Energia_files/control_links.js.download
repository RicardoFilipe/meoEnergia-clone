        var ListRenderRenderWrapper = function(itemRenderResult, inCtx, tpl)
        {
        var iStr = [];
        iStr.push(itemRenderResult);
        return iStr.join('');
        }
        ctx['ItemRenderWrapper'] = ListRenderRenderWrapper;
        ctx.OnPostRender = [];

        //Apresentação por device
        var displayMode = ctx.DataProvider.get_properties()["BlockDeviceVisibility"];
        ctx.Visibility = displayMode;

        ctx.timer = false;
        ctx.lastClientWidth = window.innerWidth;
        ctx.OnPostRender.push(function(){
           $(window).on('resize.' + ctx.ClientControl.get_id(), (function(a) {
              return function() {
                    rtime = new Date();
                    if (a.timer === false) {
                        a.timer = true;
                        setTimeout(function () { resizeend(a) }, 200);
                    }
                };
            })(ctx));
        });


        //call the aux function to build the props for REACT blocks - displaytemplateshelper
        //block links -> specific default mode
        var tmpProps = BuildBlockProps(ctx, "links", siteContext);

        var context = tmpProps.context;
        var configs = tmpProps.configs;
        var content = tmpProps.content;
        var contextMobile = tmpProps.contextMobile;
        var configsMobile = tmpProps.configsMobile;
        var contentMobile = tmpProps.contentMobile;
        var blockAnchor = tmpProps.blockAnchor;

        var queryID = $htmlEncode(ctx.ClientControl.get_nextUniqueId());
        var blockSectionClass = "block-columns_" + queryID;
        if (blockAnchor == "") {
            blockAnchor = queryID + '_sectionAnchor';
        }

         //obj no ctx para guardar info dos itens
        ctx.itemsContent = [];
        ctx.itemsContentMobile = [];


      var render = {
          getComponent: function(){
              System.import('app/blocks/links/linksApp.min.js')
                  .then(function (module) {
                      module.renderComponent(
                          document.getElementById(blockAnchor),
                          context,
                          configs,
                          content,
                          contextMobile,
                          configsMobile,
                          contentMobile,
                          displayMode
                      );
                  })
                  .catch(function (err) {
                      console.error(err);
                  });
          }
      };

      ctx.OnPostRender.push(function(){
           content.data = ctx.itemsContent;
           contentMobile.data = ctx.itemsContentMobile;
           render.getComponent();
      });


    ms_outHtml.push(''
,'        <div id="', blockAnchor ,'" data-site-context="', siteContext ,'">'
,'            <!-- react goes here -->'
,'            ', ctx.RenderGroups(ctx) ,''
,'        </div>'
,'    '
);

  ctx['DisplayTemplateData'] = cachePreviousTemplateData;
  return ms_outHtml.join('');
}
